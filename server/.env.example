# ==============================================================================
# Dayflow HRMS - Backend Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas Cluster)
MONGO_URI=mongodb://127.0.0.1:27017/dayflow_hrms

# JSON Web Token Secret & Expiration
JWT_SECRET=dayflow_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin
CLIENT_URL=http://localhost:5173

# (Optional) SMTP Email Configuration for Nodemailer alerts
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM="Dayflow HRMS <no-reply@dayflow.com>"
